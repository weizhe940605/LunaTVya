name: Sync Upstream Repository

on:
  schedule:
    # 每天早上 8 点同步一次（UTC 时区）
    - cron: '0 8 * * *'
  workflow_dispatch:
    inputs:
      branch:
        description: '要同步到的目标分支'
        required: false
        default: 'main'
        type: string

permissions:
  contents: write
  pull-requests: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Setup Git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      - name: Add upstream remote
        run: |
          git remote add upstream https://github.com/SzeMeng76/LunaTV.git || git remote set-url upstream https://github.com/SzeMeng76/LunaTV.git

      - name: Fetch upstream
        run: git fetch upstream

      - name: Check for differences
        id: check
        run: |
          # 检查是否有新的提交
          if git log -1 --oneline upstream/main ^HEAD; then
            echo "has_changes=true" >> $GITHUB_OUTPUT
          else
            echo "has_changes=false" >> $GITHUB_OUTPUT
          fi

      - name: Create sync branch
        if: steps.check.outputs.has_changes == 'true'
        run: |
          TARGET_BRANCH="${{ github.event.inputs.branch || 'main' }}"
          SYNC_BRANCH="sync/upstream-$(date +%Y%m%d-%H%M%S)"
          
          git checkout -b $SYNC_BRANCH
          git merge upstream/main --allow-unrelated-histories -m "chore: sync upstream repository"
          git push origin $SYNC_BRANCH
          
          echo "SYNC_BRANCH=$SYNC_BRANCH" >> $GITHUB_ENV
          echo "TARGET_BRANCH=$TARGET_BRANCH" >> $GITHUB_ENV

      - name: Create Pull Request
        if: steps.check.outputs.has_changes == 'true'
        uses: actions/github-script@v7
        with:
          script: |
            const syncBranch = process.env.SYNC_BRANCH;
            const targetBranch = process.env.TARGET_BRANCH;
            
            const pr = await github.rest.pulls.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: '🔄 Sync upstream repository',
              head: syncBranch,
              base: targetBranch,
              body: `## 同步上游仓库\n\n自动同步来自 [SzeMeng76/LunaTV](https://github.com/SzeMeng76/LunaTV) 的最新代码。\n\n---\n\n**操作指南：**\n- 查看代码变更\n- 解决可能的冲突\n- 检查测试是否通过\n- 合并此 PR`
            });
            
            console.log(`Created PR #${pr.data.number}`);

      - name: Sync completed
        if: steps.check.outputs.has_changes == 'false'
        run: echo "✅ 仓库已是最新，无需同步"
